# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider is selected automatically at call time (lib/llm/index.ts):
#   1. Claude   — if a key is set (added on the website → Vault, or below)
#   2. Ollama remote — the LAN box, when reachable
#   3. Ollama local  — fallback when the remote box is offline

# Remote Ollama — the LAN box with more RAM (preferred when reachable).
# SECURITY (03-LLM-PROVIDER.md): Ollama's API has no auth — keep this box on
# the trusted private LAN only, never exposed publicly.
OLLAMA_REMOTE_URL=http://192.168.31.28:11434
OLLAMA_REMOTE_MODEL=qwen2.5:14b

# Local Ollama — fallback on the machine running the app.
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen2.5:7b

# Hosted LLM APIs. Set a key here to force it via env, OR leave blank and add
# a key on the website (/settings/connectors → AI Provider) — the provider is
# auto-detected from the key format (sk-ant-… = Claude, AIza… = Gemini) and
# used for every stage. No key at all → Ollama.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared secret for scheduled jobs (GitHub Actions): the Gmail digest and the
# inbound-connector poll present this as the x-cron-secret header so they can
# trigger those endpoints without a user session. Generate a long random value.
CRON_SECRET=

# Shared secret for the Crayon outbound webhook receiver. Crayon presents it as
# x-crayon-secret (or ?secret=) so pushed alerts are authenticated.
CRAYON_WEBHOOK_SECRET=
