# Copy to .env.local for development. On Render these are set in the dashboard
# instead. Every value here is an example or a placeholder; none are real.
#
# See SETUP.md for where each value comes from.

# --- Supabase (required) --------------------------------------------------
# Supabase project → Settings → API.
# The service-role key bypasses row-level security. Server-side only, never
# expose it to a browser and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model: Litera's Entra gateway (production) ------------------
# The gateway's OpenAI-compatible endpoint and deployed model.
LITERA_API_URL=
LITERA_MODEL=gpt-5-2025-08-07

# The Entra audience for the gateway. There is a working default in the code;
# set this only if the gateway's audience changes.
LITERA_TOKEN_RESOURCE=

# An Entra token lasts about an hour. On a server there is nobody to sign in,
# so the application authenticates as itself with an app registration. Without
# these three, any job running longer than an hour fails partway through.
LITERA_TENANT_ID=
LITERA_CLIENT_ID=
LITERA_CLIENT_SECRET=

# Manual fallback: a token pasted by hand. Expires in about an hour. Useful
# only to prove the gateway works before the app registration exists.
LITERA_API_TOKEN=

# --- Competitive data: Crayon --------------------------------------------
CRAYON_API_KEY=
# Crayon presents this on pushed alerts as the x-crayon-secret header, so the
# webhook receiver can tell a real alert from anyone who found the URL.
CRAYON_WEBHOOK_SECRET=

# --- Email: Brevo ---------------------------------------------------------
# Sends invitations and the "new signal awaiting review" notification.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Compete Agent

# Who receives review notifications. Comma-separate for several.
PMM_NOTIFY_EMAIL=

# --- Application ----------------------------------------------------------
# The public URL of this deployment. Used to build links in emails, so a wrong
# value produces invitation links that go nowhere. On Render, set it to the
# service URL after the first deploy, then redeploy.
APP_URL=http://localhost:3000

# Shared secret for scheduled jobs. The feed refresh presents it as the
# x-cron-secret header, so it can run without a signed-in user. Generate a long
# random value: openssl rand -hex 32
CRON_SECRET=

# --- Alternative model providers (internal) -------------------------------
# The gateway is the production backend. These are here for development and for
# comparing output quality. A key set on the website (Settings, Connectors) wins
# over these, and the provider is detected from the key format.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local development alternative ---------------------------------------
# Ollama, for working offline without the gateway. Ollama's API has no
# authentication, so keep any remote box on a trusted private network.
# The LAN box with more memory, preferred when it is reachable.
OLLAMA_REMOTE_URL=http://192.168.31.69:11434
OLLAMA_REMOTE_MODEL=qwen:14b

# Fallback on the machine running the app.
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=qwen2.5:7b
